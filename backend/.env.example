# Database
DATABASE_URL=postgresql+psycopg2://tanisi:tanisi@localhost:5432/tanisi_erp

# Auth
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS - comma separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# WhatsApp Cloud API (optional - only needed for automated sending).
# Without these set, the app still works: PO's get a "wa.me" deep link that
# opens WhatsApp with the message pre-filled, so staff can hit Send manually.
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v20.0

# Base URL the backend is reachable at (used to build links to PDFs, etc.)
PUBLIC_BASE_URL=http://localhost:8000
