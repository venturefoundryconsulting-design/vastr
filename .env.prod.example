# Copy to .env.prod on the VPS and fill in real values. .env.prod is
# gitignored - never commit it.

DOMAIN=erp.yourdomain.com

POSTGRES_USER=tanisi
POSTGRES_PASSWORD=change-this-to-a-long-random-string
POSTGRES_DB=tanisi_erp

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-to-a-long-random-string

# Optional - WhatsApp Cloud API. Leave blank to use manual wa.me deep links.
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v20.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=tanisi-whatsapp-webhook
